<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="swarm_expansion">
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- 中心锚点（基座） -->
    <model name="central_anchor">
      <static>true</static>
      <pose>0 0 0.3 0 0 0</pose>
      <link name="anchor_link">
        <collision>
          <geometry>
            <cylinder>
              <radius>0.8</radius>
              <length>0.6</length>
            </cylinder>
          </geometry>
        </collision>
        <visual>
          <geometry>
            <cylinder>
              <radius>0.8</radius>
              <length>0.6</length>
            </cylinder>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Green</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- 外围边界墙 -->
    <model name="boundary_wall_n">
      <static>true</static>
      <pose>0 15 0.5 0 0 0</pose>
      <link name="link">
        <collision>
          <geometry><box><size>30 0.3 1</size></box></geometry>
        </collision>
        <visual>
          <geometry><box><size>30 0.3 1</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="boundary_wall_s">
      <static>true</static>
      <pose>0 -15 0.5 0 0 0</pose>
      <link name="link">
        <collision>
          <geometry><box><size>30 0.3 1</size></box></geometry>
        </collision>
        <visual>
          <geometry><box><size>30 0.3 1</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="boundary_wall_e">
      <static>true</static>
      <pose>15 0 0.5 0 0 0</pose>
      <link name="link">
        <collision>
          <geometry><box><size>0.3 30 1</size></box></geometry>
        </collision>
        <visual>
          <geometry><box><size>0.3 30 1</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="boundary_wall_w">
      <static>true</static>
      <pose>-15 0 0.5 0 0 0</pose>
      <link name="link">
        <collision>
          <geometry><box><size>0.3 30 1</size></box></geometry>
        </collision>
        <visual>
          <geometry><box><size>0.3 30 1</size></box></geometry>
        </visual>
      </link>
    </model>

    <!-- 随机散布的障碍物（30+个） -->
    <!-- 使用脚本生成多个障碍物，这里手动放置一些代表性障碍物 -->

    <!-- 北区障碍物 -->
    <model name="obs_n1"><static>true</static><pose>-8 8 0.25 0 0 0</pose>
      <link name="link"><collision><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
      <visual><geometry><box><size>0.5 0.5 0.5</size></box></visual></link></model>
    <model name="obs_n2"><static>true</static><pose>3 10 0.25 0 0 0</pose>
      <link name="link"><collision><geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry></collision>
      <visual><geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></visual></link></model>
    <model name="obs_n3"><static>true</static><pose>-5 11 0.25 0 0 0</pose>
      <link name="link"><collision><geometry><sphere><radius>0.3</radius></sphere></geometry></collision>
      <visual><geometry><sphere><radius>0.3</radius></sphere></visual></link></model>

    <!-- 南区障碍物 -->
    <model name="obs_s1"><static>true</static><pose>6 -8 0.25 0 0 0</pose>
      <link name="link"><collision><geometry><box><size>0.6 0.4 0.5</size></box></geometry></collision>
      <visual><geometry><box><size>0.6 0.4 0.5</size></box></visual></link></model>
    <model name="obs_s2"><static>true</static><pose>-3 -9 0.25 0 0 0</pose>
      <link name="link"><collision><geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry></collision>
      <visual><geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></visual></link></model>

    <!-- 东区障碍物 -->
    <model name="obs_e1"><static>true</static><pose>10 3 0.25 0 0 0</pose>
      <link name="link"><collision><geometry><box><size>0.4 0.6 0.5</size></box></geometry></collision>
      <visual><geometry><box><size>0.4 0.6 0.5</size></box></visual></link></model>
    <model name="obs_e2"><static>true</static><pose>8 -4 0.25 0 0 0</pose>
      <link name="link"><collision><geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry></collision>
      <visual><geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></visual></link></model>

    <!-- 西区障碍物 -->
    <model name="obs_w1"><static>true</static><pose>-10 5 0.25 0 0 0</pose>
      <link name="link"><collision><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
      <visual><geometry><box><size>0.5 0.5 0.5</size></box></visual></link></model>
    <model name="obs_w2"><static>true</static><pose>-9 -2 0.25 0 0 0</pose>
      <link name="link"><collision><geometry><sphere><radius>0.25</radius></sphere></geometry></collision>
      <visual><geometry><sphere><radius>0.25</radius></sphere></visual></link></model>

    <!-- 中心区障碍物 -->
    <model name="obs_c1"><static>true</static><pose>2 2 0.25 0 0 0</pose>
      <link name="link"><collision><geometry><box><size>0.4 0.4 0.5</size></box></geometry></collision>
      <visual><geometry><box><size>0.4 0.4 0.5</size></box></visual></link></model>
    <model name="obs_c2"><static>true</static><pose>-2 -2 0.25 0 0 0</pose>
      <link name="link"><collision><geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry></collision>
      <visual><geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></visual></link></model>

    <!-- 物理参数 -->
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>0 0 0.5</magnetic_field>

    <!-- 光照 -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.5 0.7 0.9 1</background>
    </scene>
  </world>
</sdf>
