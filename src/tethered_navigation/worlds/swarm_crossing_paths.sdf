<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="swarm_crossing_paths">
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>25 25</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- 外围边界墙 -->
    <!-- 上墙 -->
    <model name="wall_top">
      <static>true</static>
      <pose>0 12.5 0.5 0 0 0</pose>
      <link name="link">
        <collision>
          <geometry>
            <box><size>25 0.3 1</size></box>
          </geometry>
        </collision>
        <visual>
          <geometry>
            <box><size>25 0.3 1</size></box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- 下墙 -->
    <model name="wall_bottom">
      <static>true</static>
      <pose>0 -12.5 0.5 0 0 0</pose>
      <link name="link">
        <collision>
          <geometry>
            <box><size>25 0.3 1</size></box>
          </geometry>
        </collision>
        <visual>
          <geometry>
            <box><size>25 0.3 1</size></box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- 左墙 -->
    <model name="wall_left">
      <static>true</static>
      <pose>-12.5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision>
          <geometry>
            <box><size>0.3 25 1</size></box>
          </geometry>
        </collision>
        <visual>
          <geometry>
            <box><size>0.3 25 1</size></box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- 右墙 -->
    <model name="wall_right">
      <static>true</static>
      <pose>12.5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision>
          <geometry>
            <box><size>0.3 25 1</size></box>
          </geometry>
        </collision>
        <visual>
          <geometry>
            <box><size>0.3 25 1</size></box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- 中心障碍物 - 强制交叉 -->
    <model name="central_obstacle">
      <static>true</static>
      <pose>0 0 0.4 0 0 0</pose>
      <link name="link">
        <collision>
          <geometry>
            <box><size>2 2 0.8</size></box>
          </geometry>
        </collision>
        <visual>
          <geometry>
            <box><size>2 2 0.8</size></box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Orange</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- 额外障碍物 - 增加复杂度 -->
    <model name="obstacle_nw">
      <static>true</static>
      <pose>-6 6 0.3 0 0 0</pose>
      <link name="link">
        <collision>
          <geometry>
            <cylinder><radius>0.4</radius><length>0.6</length></cylinder>
          </geometry>
        </collision>
        <visual>
          <geometry>
            <cylinder><radius>0.4</radius><length>0.6</length></cylinder>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="obstacle_ne">
      <static>true</static>
      <pose>6 6 0.3 0 0 0</pose>
      <link name="link">
        <collision>
          <geometry>
            <cylinder><radius>0.4</radius><length>0.6</length></cylinder>
          </geometry>
        </collision>
        <visual>
          <geometry>
            <cylinder><radius>0.4</radius><length>0.6</length></cylinder>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="obstacle_sw">
      <static>true</static>
      <pose>-6 -6 0.3 0 0 0</pose>
      <link name="link">
        <collision>
          <geometry>
            <cylinder><radius>0.4</radius><length>0.6</length></cylinder>
          </geometry>
        </collision>
        <visual>
          <geometry>
            <cylinder><radius>0.4</radius><length>0.6</length></cylinder>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="obstacle_se">
      <static>true</static>
      <pose>6 -6 0.3 0 0 0</pose>
      <link name="link">
        <collision>
          <geometry>
            <cylinder><radius>0.4</radius><length>0.6</length></cylinder>
          </geometry>
        </collision>
        <visual>
          <geometry>
            <cylinder><radius>0.4</radius><length>0.6</length></cylinder>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- 物理参数 -->
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>0 0 0.5</magnetic_field>

    <!-- 光照 -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.6 0.7 0.8 1</background>
    </scene>
  </world>
</sdf>
