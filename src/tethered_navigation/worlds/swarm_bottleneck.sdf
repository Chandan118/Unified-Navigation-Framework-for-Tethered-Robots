<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="swarm_bottleneck">
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- 狭窄走廊墙壁 -->
    <!-- 左墙 -->
    <model name="wall_left">
      <static>true</static>
      <pose>-5 2.5 0.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>10 0.2 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>10 0.2 1</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Red</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- 右墙 -->
    <model name="wall_right">
      <static>true</static>
      <pose>-5 -2.5 0.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>10 0.2 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>10 0.2 1</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Red</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- 入口墙（带门开口） -->
    <!-- 左入口段 -->
    <model name="wall_entry_left">
      <static>true</static>
      <pose>-8 1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision>
          <geometry>
            <box><size>2 0.2 1</size></box>
          </geometry>
        </collision>
        <visual>
          <geometry>
            <box><size>2 0.2 1</size></box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- 右入口段 -->
    <model name="wall_entry_right">
      <static>true</static>
      <pose>-8 -1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision>
          <geometry>
            <box><size>2 0.2 1</size></box>
          </geometry>
        </collision>
        <visual>
          <geometry>
            <box><size>2 0.2 1</size></box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- 出口墙（带门开口） -->
    <!-- 左出口段 -->
    <model name="wall_exit_left">
      <static>true</static>
      <pose>8 1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision>
          <geometry>
            <box><size>2 0.2 1</size></box>
          </geometry>
        </collision>
        <visual>
          <geometry>
            <box><size>2 0.2 1</size></box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- 右出口段 -->
    <model name="wall_exit_right">
      <static>true</static>
      <pose>8 -1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision>
          <geometry>
            <box><size>2 0.2 1</size></box>
          </geometry>
        </collision>
        <visual>
          <geometry>
            <box><size>2 0.2 1</size></box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- 随机障碍物（在走廊内部） -->
    <model name="obstacle_1">
      <static>true</static>
      <pose>-2 0 0.3 0 0 0</pose>
      <link name="link">
        <collision>
          <geometry>
            <box><size>0.4 0.4 0.6</size></box>
          </geometry>
        </collision>
        <visual>
          <geometry>
            <box><size>0.4 0.4 0.6</size></box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Blue</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_2">
      <static>true</static>
      <pose>1 0 0.3 0 0 0</pose>
      <link name="link">
        <collision>
          <geometry>
            <box><size>0.3 0.3 0.6</size></box>
          </geometry>
        </collision>
        <visual>
          <geometry>
            <box><size>0.3 0.3 0.6</size></box>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="obstacle_3">
      <static>true</static>
      <pose>3 0 0.3 0 0 0</pose>
      <link name="link">
        <collision>
          <geometry>
            <cylinder>
              <radius>0.2</radius>
              <length>0.6</length>
            </cylinder>
          </geometry>
        </collision>
        <visual>
          <geometry>
            <cylinder>
              <radius>0.2</radius>
              <length>0.6</length>
            </cylinder>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- 物理参数 -->
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>0 0 0.5</magnetic_field>

    <!-- 光照 -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.6 0.7 0.8 1</background>
    </scene>
  </world>
</sdf>
