<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <!-- Meta Information -->
  <name>tethered_navigation</name>
  <version>0.1.0</version>
  <description>
    An adaptive navigation framework for tethered robots, integrating fuzzy logic,
    bug algorithms, and advanced sensor fusion for robust operation in dynamic environments.
  </description>
  <maintainer email="jetson@chandan.dev">jetson</maintainer>
  <license>Apache-2.0</license>
  <author email="jetson@chandan.dev">Chandan</author>

  <!-- Build tool dependency -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- C++ Build Dependencies -->
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>rosidl_default_generators</depend>
  <depend>rosidl_default_runtime</depend>

  <!-- Message dependencies -->
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>

  <!-- Execution Dependencies -->
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>lpms_ig1</exec_depend>
  <exec_depend>rplidar_ros</exec_depend>
  <exec_depend>ira_laser_tools</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>rqt_image_view</exec_depend>
  <exec_depend>rqt_tf_tree</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- Test Dependencies -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>